{
  "name": "hackvillage",
  "version": "0.1.0",
  "private": true,
  "description": "The open-source infrastructure for high-impact tech events — escrowed prize pools, instant payouts, verified Proof-of-Work profiles.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema db/schema.prisma && node scripts/migrate-if-production.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "prisma generate --schema db/schema.prisma && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:watch": "vitest",
    "contracts:test": "TS_NODE_PROJECT=contracts/tsconfig.json hardhat test",
    "db:migrate": "prisma migrate dev --schema db/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema db/schema.prisma",
    "db:seed": "tsx --env-file=.env db/seeds/seed.ts",
    "db:studio": "prisma studio --schema db/schema.prisma",
    "dev:fund": "tsx --env-file=.env scripts/fund-event.ts",
    "dev:cycle": "tsx --env-file=.env scripts/cycle-event.ts",
    "load:test": "tsx --env-file=.env scripts/load-test.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@node-rs/argon2": "^2.2.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@prisma/client": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "lucide-react": "^0.475.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.32",
    "pg-boss": "^10.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/chai": "^4.3.20",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "hardhat": "^2.29.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}