// HackVillage — baseline identity schema (Phase 0 of docs/BUILD_PLAN.md §6.1)
// Events, escrow, payout, judging, and media models land in Phases 2–7.
// Note: migrations and seeds live in db/ to match the structure documented in
// CONTRIBUTING.md (npm scripts pass --schema=db/schema.prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────

/// The role chosen at signup — routes onboarding only; roles are additive.
enum PrimaryRole {
  DEVELOPER
  ORGANIZER
}

/// Capability roles — additive per user; enforced server-side (plan §14.1).
enum Role {
  DEVELOPER
  ORGANIZER
  JUDGE
  HIRING
  ADMIN
}

/// Organizer organization KYB status — gate for the first deposit (Phase 3).
enum KycStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
}

enum OrgMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgMemberStatus {
  ACTIVE
  REVOKED
}

/// Event lifecycle (plan §10.1). Phase 2 owns DRAFT → PENDING_DEPOSIT only —
/// LIVE and beyond are gated by the escrow service in Phase 3.
enum EventStatus {
  DRAFT
  PENDING_DEPOSIT
  LIVE
  IN_PROGRESS
  JUDGING
  WINNERS_ANNOUNCED
  SETTLED
  CANCELLED
  DISPUTED
}

enum VenueType {
  PHYSICAL
  ONLINE
  HYBRID
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

enum TeamStatus {
  OPEN
  LOCKED
  DISBANDED
}

enum TeamMemberStatus {
  INVITED
  JOINED
  LEFT
  DECLINED
}

enum DepositStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REVERSED
}

/// Mirrors the on-chain PrizeVault state machine 1:1 (plan §10.2, §11.2).
enum VaultChainState {
  AWAITING
  LOCKED
  HALF_RELEASED
  SETTLED
  REFUNDED
}

enum LedgerEntryType {
  VAULT_CREATED
  DEPOSIT_LOCKED
  INSTANT_PAYOUT
  MILESTONE_PAYOUT
  VAULT_REFUNDED
}

enum WebhookSource {
  PAYSTACK
}

// ── Identity (Auth.js v5 adapter-compatible shapes) ───────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Null for OAuth-only accounts. Credentials auth lands in Phase 1.
  passwordHash String?
  handle        String    @unique
  avatarUrl     String?
  primaryRole   PrimaryRole
  // Set when the onboarding wizard completes — gates app routes (Phase 1).
  onboardingCompletedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Soft delete: anonymize on account deletion, payout obligations remain.
  deletedAt     DateTime?

  accounts       Account[]
  sessions       Session[]
  roleGrants     RoleGrant[]
  ownedOrgs      Organization[] @relation("OrgOwner")
  orgMemberships OrgMember[]
  profile        DeveloperProfile?
  registrations  Registration[]
  teamMemberships TeamMember[]
  ledTeams       Team[] @relation("TeamLeader")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RoleGrant {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  grantedBy String?
  grantedAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// ── Organizations ─────────────────────────────────────────────────────────

model Organization {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  logoUrl    String?
  about      String?
  ownerId    String
  kycStatus  KycStatus @default(NONE)
  // 100 + Σ TrustEvents (floor 0) — maintained by the trust service (Phase 7).
  trustScore Int       @default(100)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner   User        @relation("OrgOwner", fields: [ownerId], references: [id])
  members OrgMember[]
  invitations OrgInvitation[]
  events Event[]
}

model OrgMember {
  id     String          @id @default(cuid())
  orgId  String
  userId String
  role   OrgMemberRole
  status OrgMemberStatus @default(ACTIVE)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

/// Invite codes for joining an organization (Phase 1: create/join org in
/// onboarding, plus /invites/[code] for existing users).
model OrgInvitation {
  id        String        @id @default(cuid())
  orgId     String
  email     String
  role      OrgMemberRole @default(MEMBER)
  token     String        @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime      @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([email])
}

// ── Developer Proof-of-Work profile ──────────────────────────────────────

model DeveloperProfile {
  userId String @id
  headline String?
  bio String?
  skills String[]
  githubLogin String?
  linkedinUrl String?
  location String?
  // Public browse visibility (privacy toggle, plan §7.4).
  visible Boolean @default(true)
  // Paystack transfer recipient — required before a user can be marked a
  // winner (plan §6.1 invariant). Wired in Phase 5.
  payoutRecipientCode String?
  // "MPESA" | "BANK" — promoted to an enum when the payout service lands.
  payoutMethod String?
  // Derived metric — recomputed by jobs, never client-writable.
  winRateCached Float?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Events & Teams (Phase 2 — no money code; deposits arrive in Phase 3) ──

model Event {
  id String @id @default(cuid())
  orgId String
  slug String @unique
  title String
  summary String?
  problemStatement String?
  rules String?
  venueType VenueType
  location String?
  coverUrl String?
  startsAt DateTime
  endsAt DateTime
  registrationDeadline DateTime
  maxTeams Int @default(20)
  rolesWanted String[]
  status EventStatus @default(DRAFT)
  // Set by the escrow service when the vault locks (Phase 3).
  prizeVerifiedAt DateTime?
  // endsAt + 48h — enforced by the media job (Phase 7).
  mediaDeadlineAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  prizes PrizeBreakdown[]
  roleTags EventRoleTag[]
  registrations Registration[]
  teams Team[]
  deposits Deposit[]
  vault VaultState?
  ledgerEntries LedgerEntry[]

  @@index([status, startsAt])
}

/// Pool amount is derived: the pool equals Σ PrizeBreakdown.amountKes for the
/// event (Decision D1/D5 — organizers fund the pool, platform adds 5% on top
/// at deposit time, ADR-012).
model PrizeBreakdown {
  id String @id @default(cuid())
  eventId String
  place Int
  label String
  amountKes Int
  milestoneRequired Boolean @default(true)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, place])
}

model EventRoleTag {
  id String @id @default(cuid())
  eventId String
  tag String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, tag])
}

model Registration {
  id String @id @default(cuid())
  eventId String
  userId String
  status RegistrationStatus @default(REGISTERED)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Team {
  id String @id @default(cuid())
  eventId String
  name String
  leaderId String
  inviteCode String @unique
  status TeamStatus @default(OPEN)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leader User @relation("TeamLeader", fields: [leaderId], references: [id])
  members TeamMember[]
  submission Submission?

  @@index([eventId])
}

model TeamMember {
  id String @id @default(cuid())
  teamId String
  userId String
  status TeamMemberStatus @default(INVITED)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Submission {
  id String @id @default(cuid())
  teamId String @unique
  repoUrl String
  demoUrl String?
  description String
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// [{userId, percent}] — must sum to 100; visible to all members (ADR-013).
  splitDeclaration Json?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ── Escrow (Phase 3 — hard boundary; services/escrow owns these rows) ────

model Deposit {
  id String @id @default(cuid())
  eventId String
  /// Unique per attempt — the Paystack transaction reference. Idempotency
  /// anchor for webhook replays (P3).
  paystackReference String @unique
  /// gross = pool portion + platform fee (ADR-012).
  grossAmountKes Int
  poolAmountKes Int
  feeKes Int
  currency String @default("KES")
  channel String?
  status DepositStatus @default(INITIATED)
  /// Paystack authorization_url — or the dev simulation checkout in local dev.
  authorizationUrl String?
  paidAt DateTime?
  rawWebhook Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model VaultState {
  id String @id @default(cuid())
  eventId String @unique
  /// The pool portion only — the fee never enters the vault (ADR-012).
  amountKes Int
  contractAddress String?
  chainState VaultChainState @default(AWAITING)
  lockedAt DateTime?
  halfReleasedAt DateTime?
  settledAt DateTime?
  refundedAt DateTime?
  lastTxHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// Mirror of on-chain attestation events — the /trust page reads this table;
/// the chain remains the source of truth (plan §11.3).
model LedgerEntry {
  id String @id @default(cuid())
  eventId String
  type LedgerEntryType
  payload Json
  txHash String @unique
  blockNumber Int?
  mirroredAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// Webhook replay guard — unique(source, eventType, reference). Raw payloads
/// are retained for forensics (plan §14.2).
model WebhookEvent {
  id String @id @default(cuid())
  source WebhookSource
  eventType String
  reference String
  signatureOk Boolean @default(false)
  payload Json
  processedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([source, eventType, reference])
}

/// Append-only audit log for privileged actions (KYB approvals, trust
/// adjustments, admin overrides — plan §6.8, P10).
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String?
  reason String?
  meta Json?
  createdAt DateTime @default(now())
}
